# Firebase configuration for Glim.
#
# Copy this file to .env.local and fill in the values from:
#   Firebase console > Project settings > General > Your apps > Web app
#
# .env.local holds the PRODUCTION project and is read by `npm run build`,
# `npm run build:ios` (Vite mode "native") and `npm run preview`. CI does not
# read it at all; the deploy workflow injects the same names from GitHub
# repository secrets.
#
# To develop against a SEPARATE Firebase project, put that project's values in
# .env.development.local instead. Vite gives `.env.[mode].local` precedence
# over `.env.local`, so `npm run dev` picks up the development project while
# every production path keeps reading .env.local. Both files match the *.local
# pattern in .gitignore. See the README for the full setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
