rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Ownership: each user can only read/write their own subtree.
    // ------------------------------------------------------------------------
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The shape Date.prototype.toISOString() produces: UTC, fixed width. Every
    // timestamp Glim writes has this shape, so string comparison on two such
    // values is correct chronological ordering.
    function isIsoStamp(v) {
      return v is string
          && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$');
    }

    // The edit-in-place collections whose rows carry updatedAt and reconcile by
    // last-write-wins. Everything else under a user is either a write-once
    // entry log or a singleton that reconciles by read-and-compare.
    function isMutable(collectionId) {
      return collectionId in [
        'nutrition-library', 'symptoms', 'symptoms-library',
        'symptom-categories', 'symptom-days', 'steps-health', 'cycle'
      ];
    }

    // ------------------------------------------------------------------------
    // Field validation for steps-health (2026-09-17).
    //
    // The FIRST per-field validation in this file, and deliberately scoped to
    // one collection: step totals read out of Apple Health are the most
    // sensitive data Glim syncs, they have a small fixed shape, and they are
    // written by an automatic background path rather than by a user action, so
    // a future client bug could quietly fill the collection with nonsense.
    //
    // Kept INSIDE the single data-document rule below rather than added as its
    // own match block. Firestore grants a request if ANY matching allow is
    // true, so a second block matching the same path would bypass the
    // updatedAt monotonicity backstop entirely. A static test asserts there are
    // exactly two match blocks under /users for this reason.
    //
    // `steps is int` relies on the client SDK writing whole JS numbers as
    // integers. Believed true, and confirmed by the first real device write; if
    // a real write is ever rejected, relax this to `is number`, do NOT loosen
    // the client.
    // ------------------------------------------------------------------------
    function stepsHealthValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'source', 'date', 'steps', 'updatedAt', 'syncedAt'])
          && d.source in ['healthkit', 'health_connect']
          && d.steps is int && d.steps >= 0
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isIsoStamp(d.updatedAt);
    }

    // ------------------------------------------------------------------------
    // Field validation for cycle (2026-09-18).
    //
    // The SECOND per-field validator, and warranted more than the first: flow
    // rows are the most sensitive data Glim will ever hold, and the shape is
    // small and fixed. Like stepsHealthValid, it lives INSIDE the single data
    // document rule below rather than in its own match block - Firestore grants
    // a request if ANY matching allow is true, so a second block matching the
    // same path would bypass the updatedAt backstop entirely.
    //
    // hasAll as well as hasOnly: hasOnly permits any SUBSET, so without hasAll a
    // row missing createdAt or flow would pass.
    //
    // `d.id == d.date` is the rule that makes one-row-per-day structural. The
    // client validates it too (useCycleStore.validateRow). Client and server
    // MUST agree: a row the client accepts and the server refuses pushes
    // forever and fails forever, visible only as a console.warn in sync.js.
    //
    // note.size() counts Unicode code points here and UTF-16 code units on the
    // client, so the client is strictly stricter. That is the safe direction;
    // do not "fix" it by loosening the client.
    // ------------------------------------------------------------------------
    function cycleValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'date', 'flow', 'isPeriodStart', 'note',
                               'createdAt', 'updatedAt', 'deletedAt', 'syncedAt'])
          && d.keys().hasAll(['id', 'date', 'flow', 'createdAt', 'updatedAt'])
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.id == d.date
          && d.flow in ['none', 'spotting', 'light', 'medium', 'heavy']
          && (!('isPeriodStart' in d) || d.isPeriodStart == null || d.isPeriodStart is bool)
          && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 500))
          && isIsoStamp(d.createdAt) && isIsoStamp(d.updatedAt);
    }

    // ------------------------------------------------------------------------
    // updatedAt monotonicity: a write may never move a document's updatedAt
    // backwards.
    //
    // This is the server-side backstop for the client's last-write-wins merge.
    // The client pulls before it pushes, but a client is not something the
    // server can trust: an older installed PWA on a rarely-opened device, or a
    // future client bug, could still blind-push a stale row over a newer one,
    // updatedAt included, after which nothing can recover it. This rule makes
    // that write fail at the server regardless of which client sent it.
    //
    // ">=" rather than ">": an idempotent re-push of an unchanged row carries
    // an equal updatedAt and must succeed. Creates (resource == null), rows
    // with no updatedAt on either side, and rows whose EXISTING stamp is not a
    // well-formed ISO string are allowed through: the first two so the rule
    // cannot brick a collection that predates the field, the last so a client
    // holding a good copy can repair a corrupt one (a lexicographic compare of
    // '2026-...' against garbage would otherwise deny the repair forever).
    // ------------------------------------------------------------------------
    function updatedAtNotRegressing() {
      return resource == null
          || !('updatedAt' in resource.data)
          || !isIsoStamp(resource.data.updatedAt)
          || !('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    // The user document itself (users/{uid}), written once by
    // ensureUserDocument in App.jsx.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Every Glim data document lives exactly one collection below the user
    // document. EXACTLY ONE GRANTING rule matches each such path (the global
    // catch-all below also matches, and grants nothing). There is deliberately
    // no recursive {document=**} under /users: Firestore grants a request if
    // ANY matching allow statement is true, so a recursive ownership-only rule
    // alongside the specific one would silently grant every write the
    // monotonicity check denies, and the backstop would enforce nothing. (That
    // is how the first draft of this file was written. A static test now
    // asserts the recursive form is absent.)
    match /users/{userId}/{collectionId}/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
          && (!isMutable(collectionId) || updatedAtNotRegressing())
          && (collectionId != 'steps-health' || stepsHealthValid())
          && (collectionId != 'cycle' || cycleValid());
      // Deletes are not gated on updatedAt: request.resource is null on a
      // delete, so the check cannot be evaluated, and the reset-all-data path
      // hard-deletes by design.
      allow delete: if isOwner(userId);
    }

    // Deny everything else, including any path deeper than the above.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
